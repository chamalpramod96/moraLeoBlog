    // ─────────────────────────────────────────────────────────────────────────
    // HOW TO USE THIS FILE
    // This is NOT a complete rules file. Paste everything below into
    // moraLeoPortal/storage.rules, just above the "Deny everything else"
    // block at the bottom. Never deploy this file on its own.
    // ─────────────────────────────────────────────────────────────────────────

    // ── Blog images (moraLeoBlog) ───────────────────────────────────────────
    // Path: blog/{postId}/{fileName}
    // • Everyone can VIEW an image they have the address of (the blog shows
    //   them to all visitors), but nobody outside can list the folder, so the
    //   cover of an unpublished draft can't be found
    // • Admins (Secretary, President, Super Admin) and the editors they listed
    //   (blogEditors in firestore.rules) upload. The admin page shrinks photos
    //   first, so the 3 MB cap stops full-size originals slipping onto the blog
    // • Only admins delete
    function isBlogEditor() {
      return isAdmin() ||
        (isActiveMember() &&
         firestore.exists(
           /databases/(default)/documents/blogEditors/$(request.auth.token.email)
         ));
    }

    match /blog/{postId}/{fileName} {
      allow get:    if true;
      allow list:   if isBlogEditor();
      allow write:  if isBlogEditor()
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
