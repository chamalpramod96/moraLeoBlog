    // ─────────────────────────────────────────────────────────────────────────
    // HOW TO USE THIS FILE
    // This is NOT a complete rules file. Paste everything below into
    // moraLeoPortal/firestore.rules, just above the "Deny everything else"
    // block at the bottom. Never deploy this file on its own.
    // ─────────────────────────────────────────────────────────────────────────

    // ═════════════════════════════════════════════════════════════════════════
    // BLOG (moraLeoBlog) — edited from the blog's /admin page
    // ═════════════════════════════════════════════════════════════════════════
    // The blog is run by the portal's admins — Secretary, President and Super
    // Admin (isAdmin() above) — the same people who may use the club website's
    // admin. They write, publish and delete.
    // They can also list other ACTIVE MEMBERS in blogEditors/{email} as
    // editors: an editor writes their own drafts and sends them for review,
    // but can't publish. A member who leaves the club loses the blog too.

    function blogEditorDoc() {
      return /databases/$(database)/documents/blogEditors/$(request.auth.token.email);
    }

    // May open the blog's admin page at all: an admin, or a listed editor
    function isBlogEditor() {
      return isAdmin() || (isActiveMember() && exists(blogEditorDoc()));
    }

    function isBlogText(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // ── Blog editors (members the admins have let in) ────────────────────────
    match /blogEditors/{email} {
      // Anyone signed in may read their OWN entry (the admin page checks it);
      // only admins see the whole list
      allow read: if (isAuthenticated() && request.auth.token.email == email) ||
        isAdmin();

      // Doc ids are lowercase emails (Firebase Auth lowercases them too, so a
      // mixed-case id never matches)
      allow create, update: if isAdmin() &&
        email == email.lower() &&
        request.resource.data.keys().hasOnly(['name']) &&
        isBlogText(request.resource.data.name, 1, 100);

      allow delete: if isAdmin();
    }

    // ── Blog posts ───────────────────────────────────────────────────────────
    // The cover image is a Storage path under blog/… or a file of the blog site
    // itself (images/…) — never a full URL, so a post can't point at an outside
    // image. People are recorded by account id, never by email: published posts
    // are readable by everyone.
    function isValidBlogPost(d) {
      return d.keys().hasOnly(['title', 'slug', 'excerpt', 'category', 'tags', 'author', 'readTime',
                               'status', 'featured', 'coverImage', 'contentHtml', 'seo', 'date',
                               'publishedAt', 'createdAt', 'updatedAt', 'createdByUid', 'updatedByUid']) &&
        isBlogText(d.title, 1, 200) &&
        d.slug is string && d.slug.size() <= 120 && d.slug.matches('[a-z0-9]+(-[a-z0-9]+)*') &&
        isBlogText(d.excerpt, 0, 600) &&
        d.category is string && d.category.matches('[a-z]{2,30}') &&
        d.tags is list && d.tags.size() <= 15 &&
        isBlogText(d.author, 0, 100) &&
        isBlogText(d.readTime, 0, 30) &&
        d.status in ['draft', 'review', 'published'] &&
        d.featured is bool &&
        d.coverImage is string &&
        (d.coverImage == '' ||
         d.coverImage.matches('blog/[^/]+/[^/]+') ||
         d.coverImage.matches('images/[A-Za-z0-9/_.-]+')) &&
        isBlogText(d.contentHtml, 0, 300000) &&
        d.seo is map &&
        d.date is string && (d.date == '' || d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')) &&
        (d.status != 'published' || d.date != '') &&
        isBlogText(d.publishedAt, 0, 40) &&
        isBlogText(d.createdAt, 1, 40) &&
        isBlogText(d.updatedAt, 1, 40) &&
        d.updatedByUid == request.auth.uid;
    }

    match /blogPosts/{postId} {
      // Visitors open ONE published post at a time (the list they see is
      // blogIndex/current below); only admins and editors can list, drafts included
      allow get:  if resource.data.status == 'published' || isBlogEditor();
      allow list: if isBlogEditor();

      // An editor starts drafts under their own account; publishing and
      // featuring are the admins' decisions
      allow create: if isBlogEditor() &&
        isValidBlogPost(request.resource.data) &&
        request.resource.data.createdByUid == request.auth.uid &&
        (isAdmin() ||
         (request.resource.data.status in ['draft', 'review'] &&
          request.resource.data.featured == false));

      // An editor changes only their own post, and only until it is published
      allow update: if isBlogEditor() &&
        isValidBlogPost(request.resource.data) &&
        request.resource.data.createdByUid == resource.data.createdByUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (isAdmin() ||
         (resource.data.createdByUid == request.auth.uid &&
          resource.data.status in ['draft', 'review'] &&
          request.resource.data.status in ['draft', 'review'] &&
          request.resource.data.featured == resource.data.featured));

      allow delete: if isAdmin() ||
        (isBlogEditor() &&
         resource.data.createdByUid == request.auth.uid &&
         resource.data.status in ['draft', 'review']);
    }

    // ── Published list ──────────────────────────────────────────────────────
    // One document (blogIndex/current) with the title, excerpt, date… of every
    // published post — no article text. The blog reads it once per visit, so a
    // visit costs one read however many posts there are. The admin page
    // rewrites it after every publish, unpublish or delete.
    match /blogIndex/{docId} {
      allow read:  if true;
      allow write: if isAdmin() &&
        docId == 'current' &&
        request.resource.data.keys().hasOnly(['posts', 'updatedAt']) &&
        request.resource.data.posts is list &&
        request.resource.data.posts.size() <= 1000 &&
        isBlogText(request.resource.data.updatedAt, 1, 40);
    }
